<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.alfresco</groupId>
        <artifactId>alfresco-search-and-insight-parent</artifactId>
        <version>2.1.0-A.1-SNAPSHOT</version>
    </parent>
    <artifactId>alfresco-search-parent</artifactId>
    <version>2.1.0-A.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Alfresco Solr Search parent</name>
    <properties>
        <licenseName>community</licenseName>
    </properties>
    <modules>
        <module>alfresco-solrclient-lib</module>
        <module>alfresco-search</module>
        <module>packaging</module>
    </modules>

    <distributionManagement>
        <repository>
            <id>alfresco-releases</id>
            <name>Alfresco Community Releases</name>
            <!-- TODO: switch to maven.artifacts.hyland.dev once its DNS record exists -->
            <url>https://maven.cloudsmith.io/hyland/alfresco-community-releases/</url>
        </repository>
    </distributionManagement>

    <profiles>
        <profile>
            <id>prerelease</id>
            <distributionManagement>
                <repository>
                    <id>alfresco-releases</id>
                    <name>Alfresco Internal Releases</name>
                    <!-- TODO: switch to maven.artifacts.hyland.dev once its DNS record exists -->
                    <url>https://maven.cloudsmith.io/hyland/alfresco-internal-releases/</url>
                </repository>
            </distributionManagement>
        </profile>
    </profiles>

    <repositories>
        <repository>
            <id>alfresco-public</id>
            <url>https://artifacts.hyland.dev/public/alfresco-public/maven/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>central</id>
            <name>Central Repository</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <layout>default</layout>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>
</project>
